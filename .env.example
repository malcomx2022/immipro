# ── Application ────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Base de données ────────────────────────────────────────
DATABASE_URL=postgresql://immipro:changeme@localhost:5432/immipro?schema=public
POSTGRES_USER=immipro
POSTGRES_PASSWORD=changeme
POSTGRES_DB=immipro

# ── Authentification ───────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stockage MinIO ─────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=immipro
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_DOCUMENTS=immipro-documents
MINIO_PRESIGNED_TTL_SECONDS=300

# ── IA ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_TOKENS_PACK_ESSENTIEL=120000
AI_TOKENS_PACK_DOSSIER=400000
AI_TOKENS_PACK_PRO=1200000

# ── Paiement FedaPay (XOF) ─────────────────────────────────
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# ── Paiement Stripe (EUR) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notifications ──────────────────────────────────────────
SMTP_URL=
SMS_PROVIDER_KEY=

# ── Rétention (jours) ──────────────────────────────────────
RETENTION_DOCUMENTS_DAYS=90
