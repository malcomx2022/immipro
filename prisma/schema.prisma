generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// Référentiel réglementaire versionné
// ═══════════════════════════════════════════════════════════

enum VisaCategory {
  ETUDES
  EMPLOI
  FAMILLE
  RECHERCHE_EMPLOI
}

/// Niveau de confiance de la source. Pilote l'affichage côté utilisateur
/// et conditionne la publication (INV-4).
enum SourceTier {
  OFFICIEL
  INSTITUTIONNEL
  SECONDAIRE
}

enum RuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model VisaRule {
  id            String       @id @default(uuid())
  countryCode   String       @db.Char(2)
  visaType      String
  category      VisaCategory
  version       Int
  effectiveFrom DateTime     @db.Date
  effectiveTo   DateTime?    @db.Date
  rules         Json
  schemaVersion Int          @default(1)
  sourceUrl     String
  sourceTier    SourceTier
  verifiedAt    DateTime     @db.Date
  verifiedBy    String
  /// Alimente la file de veille (WF-14).
  nextReviewAt  DateTime     @db.Date
  status        RuleStatus   @default(DRAFT)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  applications   Application[]
  migrationsFrom RuleMigration[] @relation("MigrationFrom")
  migrationsTo   RuleMigration[] @relation("MigrationTo")

  @@unique([countryCode, visaType, version])
  @@index([countryCode, category, status])
  @@index([status, nextReviewAt])
}

// ═══════════════════════════════════════════════════════════
// Comptes
// ═══════════════════════════════════════════════════════════

/// Rôles de la plateforme, repris des acteurs de DOC-11. `CONSULTANT` n'y
/// figure pas : un consultant est référencé (table `Consultant`) et accède à
/// un dossier par un accord nominatif, il ne se connecte pas encore.
///
/// RG-15.3 : moindre privilège. Un veilleur relit des sources et rédige des
/// versions de règle ; il ne voit ni les paiements ni les pièces d'identité.
enum Role {
  CANDIDAT
  VEILLEUR
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  phone         String?
  countryCode   String?   @db.Char(2)
  locale        String    @default("fr")
  emailVerified DateTime?
  role          Role      @default(CANDIDAT)
  /// Suspension administrative (WF-15). Elle coupe les sessions en cours :
  /// c'est la raison pour laquelle la session est en base et non dans un
  /// jeton signé, qu'on ne peut pas retirer avant son échéance.
  suspendedAt   DateTime?
  /// Échecs de connexion consécutifs, et blocage temporaire (A-02).
  ///
  /// Le compteur est sur le compte et non sur l'adresse d'appel : une
  /// attaque par liste de mots de passe change d'adresse à chaque essai, et
  /// un comptage par adresse ne la voit pas. Il est remis à zéro par une
  /// connexion réussie.
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())

  /// Suppression de compte demandée par le candidat (RG-10.4).
  ///
  /// La ligne survit à la suppression, et ce n'est pas une facilité : un
  /// reçu de paiement pointe dessus et doit lui survivre (C-11 l'annonce au
  /// candidat, l'obligation comptable l'impose). Ce qui part, c'est tout ce
  /// qui nomme quelqu'un ; ce qui reste, c'est un compte sans personne.
  ///
  /// Deux dates et non une : entre la demande et l'anonymisation, il y a la
  /// purge des pièces, qui dépend d'un stockage objet susceptible d'être
  /// indisponible. `deletionRequestedAt` seul est l'état « suppression
  /// demandée » que B-03 sait afficher et que le job reprend.
  deletionRequestedAt DateTime?
  deletedAt           DateTime?

  profile       Profile?
  consents      Consent[]
  applications  Application[]
  transactions  Transaction[]
  aiUsage       AiUsage[]
  notifications Notification[]
  sessions      Session[]
  secrets       AuthSecret[]

  /// La reprise des suppressions restées à mi-chemin (RG-10.4) balaie
  /// exactement ces deux colonnes, une fois par nuit, sur toute la table.
  /// L'index existait en base depuis la migration qui a créé les colonnes,
  /// sans être déclaré ici : un prochain `migrate dev` l'aurait supprimé.
  @@index([deletionRequestedAt, deletedAt])
}

/// Session serveur, révocable.
///
/// DOC-11 (WF-02) demande des sessions en base. Un jeton signé serait plus
/// simple, mais il ne se retire pas : une suspension de compte (WF-15) ou un
/// changement de mot de passe ne prendraient effet qu'à son expiration. Ici
/// une ligne supprimée ferme l'accès au prochain appel.
///
/// Le cookie porte un secret aléatoire ; la table n'en garde que
/// l'empreinte. Une lecture de la base ne permet donc pas de se faire passer
/// pour quelqu'un.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Contexte de la connexion, pour qu'un candidat reconnaisse une session
  /// qui n'est pas la sienne. Jamais l'adresse complète : elle n'apporte
  /// rien à l'écran et se conserverait sans motif.
  userAgent  String?

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

enum AuthSecretKind {
  VERIFICATION_EMAIL
  REINITIALISATION_MOT_DE_PASSE
}

/// Code ou jeton à usage unique (A-03, A-04).
///
/// `consumedAt` plutôt qu'une suppression : un code déjà utilisé doit se
/// distinguer d'un code jamais émis, sans quoi le message d'échec ne peut
/// pas dire lequel des deux s'est produit — et c'est la différence entre
/// « demande un nouveau code » et « vérifie ton adresse ».
///
/// `attempts` borne la recherche par essais : six chiffres se devinent en un
/// million de tentatives, ce qui n'est rien pour une machine.
model AuthSecret {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       AuthSecretKind
  secretHash String
  expiresAt  DateTime
  attempts   Int            @default(0)
  consumedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([userId, kind, consumedAt])
  @@index([expiresAt])
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectif        String?
  highestDegree   String?
  fieldOfStudy    String?
  yearsExperience Int?
  languages       Json?
  budgetTotal     Int?
  budgetCurrency  String?
  updatedAt       DateTime @updatedAt
}

/// Un consentement par autorisation affichée (A-05).
///
/// La première version en regroupait plusieurs sous une même catégorie
/// juridique : deux autorisations partageaient `MARKETING`, deux autres
/// `PIECES_IDENTITE`. L'écran lisait alors la dernière ligne de la
/// catégorie, si bien que retirer l'une affichait l'autre comme retirée.
/// Une preuve de consentement qui répond pour une autre n'en est pas une.
///
/// `tests/schema-domaine.test.ts` compare cette liste au type
/// `CodeConsentement` du domaine : elles ne peuvent plus diverger.
enum ConsentKind {
  CGU
  PIECES_IDENTITE
  PIECES_FINANCIERES
  ALERTES_REGLES
  PARTENAIRES
  MESURE_AUDIENCE
}

/// Le consentement au traitement des pièces d'identité est séparé
/// et révocable (RG-02.1).
model Consent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ConsentKind
  granted   Boolean
  version   String
  grantedAt DateTime    @default(now())
  revokedAt DateTime?

  @@index([userId, kind])
}

// ═══════════════════════════════════════════════════════════
// Dossiers
// ═══════════════════════════════════════════════════════════

enum ApplicationStatus {
  BROUILLON
  ACTIF
  PRET
  SOUMIS
  SUSPENDU
  ISSUE_DECLAREE
  ABANDONNE
  ARCHIVE
}

enum Issue {
  ACCEPTE
  REFUSE
  SANS_REPONSE
  RENONCE
}

model Application {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Snapshot de la règle au moment de l'ouverture (INV-3).
  visaRuleId String?
  visaRule   VisaRule? @relation(fields: [visaRuleId], references: [id])

  status ApplicationStatus @default(BROUILLON)

  /// Barème interne, 0 à 100 (WF-07). Back-office seul : il n'est jamais
  /// sérialisé vers le candidat, qui voit un palier et un dénombrement
  /// (arbitrage C-09). Le nom le rappelle à qui écrit une requête.
  internalScore Int       @default(0)
  /// Passage en PRET : calculé, jamais déclaré (RG-07.2). Remis à null
  /// dès qu'une pièce régresse, y compris par péremption (RG-07.4).
  readyAt       DateTime?

  targetDate  DateTime? @db.Date
  /// Dernier rappel groupé envoyé pour ce dossier — RG-09.2, « un email
  /// hebdomadaire ». La cadence porte sur le dossier ; l'exception
  /// d'urgence porte sur l'échéance (`Deadline.remindedAt`).
  lastReminderAt DateTime?
  submittedAt DateTime?
  issue       Issue?
  issueReason String?
  /// Échéance de purge annoncée au candidat à la clôture (INV-5, RG-10.2).
  purgeDueAt  DateTime?
  purgedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  documents     Document[]
  deadlines     Deadline[]
  transactions  Transaction[]
  aiUsage       AiUsage[]
  credits       AnalysisCredit[]
  notifications Notification[]
  migrations    RuleMigration[]
  accesses      ConsultantAccess[]
  appointments  Appointment[]
  referrals     PartnerReferral[]

  @@index([userId, status])
  @@index([visaRuleId])
  @@index([status, purgeDueAt])
}

enum DocumentStatus {
  ATTENDUE
  EN_ANALYSE
  CONFORME
  A_CORRIGER
  ILLISIBLE
  HORS_SUJET
  EXPIREE
  PURGEE
}

/// Ce qui lève le manque. C'est le remède, et non l'état, qui détermine
/// l'action proposée : un passeport trop court se remplace à
/// l'administration, et « Ajouter » mentirait sur l'effort demandé.
enum DocumentRemedy {
  TELEVERSER
  REMPLACER
  REDIGER
  DEMARCHE
}

enum DocumentFamily {
  OBLIGATOIRE
  COMPLEMENTAIRE
}

model Document {
  id            String         @id @default(uuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  code          String
  label         String
  family        DocumentFamily @default(OBLIGATOIRE)
  required      Boolean        @default(true)
  remedy        DocumentRemedy @default(TELEVERSER)
  status        DocumentStatus @default(ATTENDUE)

  extracted Json?
  /// Message actionnable affiché à l'utilisateur (RG-06.3).
  feedback  String?
  /// Le même constat en forme brève : mesure, exigence, action.
  finding   String?
  /// Conseil propre à cette pièce, affiché au dépôt. « Le PDF de ton
  /// application bancaire se lit mieux » ne vaut que pour un relevé.
  hint      String?

  /// Durée de validité, en mois, des pièces périssables (RG-06.6). Elle sert
  /// aussi à calculer la date « au plus tôt » de l'échéancier (WF-09).
  validityMonths Int?
  expiresAt      DateTime? @db.Date
  analyzedAt     DateTime?
  createdAt      DateTime  @default(now())

  versions  DocumentVersion[]
  interview InterviewAnswer[]

  @@unique([applicationId, code])
  @@index([status, expiresAt])
  @@index([applicationId, family, status])
}

model Deadline {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  code          String
  label         String
  dueAt         DateTime    @db.Date
  doneAt        DateTime?

  /// Dernier rappel qui portait cette échéance — WF-09 étape 3.
  ///
  /// Par échéance et non par dossier : une urgence échappe à la cadence
  /// hebdomadaire (RG-09.2), et sans cette marque elle repartirait chaque
  /// jour jusqu'à la date — la façon la plus sûre de se faire filtrer.
  remindedAt    DateTime?

  @@index([applicationId, dueAt])
  @@index([dueAt, doneAt])
}

// ═══════════════════════════════════════════════════════════
// Paiements
// ═══════════════════════════════════════════════════════════

enum PaymentProvider {
  FEDAPAY
  STRIPE
}

/// Pourquoi un paiement n'a pas abouti — N.B.
///
/// Vocabulaire fermé, et volontairement grossier. Les deux rails ne disent
/// pas la même chose et ne disent pas tout : FedaPay distingue le refus,
/// l'annulation et la panne par son seul `status`, Stripe donne un code de
/// refus normalisé. Ce qui entre ici est ce que les deux savent exprimer,
/// et rien de ce qui désigne un moyen de paiement.
enum PaymentFailure {
  /// L'émetteur a nommé le solde. Le seul cas où l'écran ose le dire.
  SOLDE_INSUFFISANT
  /// Refusé, sans raison communiquée. Le cas le plus fréquent.
  REFUS_EMETTEUR
  /// Le payeur a renoncé sur son téléphone ou fermé la page du prestataire.
  ANNULE_PAR_LE_PAYEUR
  /// Carte expirée, numéro erroné, portefeuille non autorisé au marchand.
  MOYEN_INVALIDE
  /// Panne du côté de l'émetteur ou du prestataire. Rien à corriger chez soi.
  INCIDENT_TECHNIQUE
  /// Aucune réponse dans le délai. Prononcé par la plateforme, pas reçu.
  DELAI_DEPASSE
}

enum TransactionStatus {
  INITIEE
  EN_ATTENTE
  CONFIRMEE
  ECHOUEE
  EXPIREE
  REMBOURSEE
}

model Transaction {
  id            String            @id @default(uuid())
  reference     String            @unique
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  applicationId String?
  application   Application?      @relation(fields: [applicationId], references: [id])
  packCode      String
  amount        Int
  currency      String            @db.Char(3)
  provider      PaymentProvider
  /// Identifiant de la transaction chez le fournisseur.
  ///
  /// Posé à la première notification et **jamais réécrit** — M.B. Il servait
  /// aussi de clé d'idempotence, ce qui confondait deux choses : « quelle
  /// transaction est-ce chez eux » et « ai-je déjà vu cette notification ».
  /// Chez FedaPay les deux coïncident, et un remboursement portant le même
  /// identifiant se lisait donc comme un rejeu ; chez Stripe ils diffèrent,
  /// et le remboursement écrasait la référence que le reçu cite. La clé
  /// d'idempotence est désormais `PaymentEvent.providerEventId`.
  providerTxId  String?           @unique
  status        TransactionStatus @default(INITIEE)
  createdAt     DateTime          @default(now())
  confirmedAt   DateTime?

  /// Pourquoi le paiement n'a pas abouti — N.B.
  ///
  /// Une catégorie à nous, jamais le texte du fournisseur. Ce qu'il envoie
  /// cite un moyen de paiement, parfois un message de banque ; ce qu'on en
  /// retient tient dans six mots fermés, qui suffisent à écrire la bonne
  /// phrase au candidat et à ne pas accuser son solde à tort.
  ///
  /// Elle part avec le compte (RG-10.4). L'obligation comptable porte sur
  /// le montant, la date et la référence, pas sur la raison pour laquelle
  /// une carte a été refusée un jour.
  failureCause PaymentFailure?

  /// Quand l'échec a eu lieu — O.B.
  ///
  /// La date de l'échec, et non celle de la transaction : entre l'ouverture
  /// et l'échec il y a le délai de confirmation, et pour une expiration
  /// prononcée par la réconciliation, parfois des heures. C'est depuis elle
  /// que court la conservation de quatre-vingt-dix jours.
  ///
  /// Elle ne vit jamais sans le motif ni le motif sans elle : la base le
  /// refuse. Un motif sans date échapperait à la purge en silence.
  failureCauseAt DateTime?

  /// Rapprochement bancaire : distinct du cycle de paiement. Un silence de
  /// l'opérateur laisse `reconciledAt` nul sans faire basculer `status` en
  /// échec — aucun paiement n'est accusé sur l'absence de réponse d'un tiers.
  reconciledAt DateTime?
  /// Écart constaté, conservé **y compris après** sa résolution (B-04).
  ///
  /// Il ne s'efface pas : l'historique doit dire qu'un désaccord a existé
  /// et ce qu'il disait, pas seulement qu'il n'y en a plus. Sa clôture
  /// s'écrit dans les quatre colonnes qui suivent.
  discrepancy  String?

  /// Comment l'écart s'est refermé — arbitrage du 21/09/2026.
  ///
  /// Les quatre vont ensemble, et la base l'exige. L'issue dit ce qui a
  /// été décidé, la note pourquoi, la date quand — c'est elle qui
  /// déclenche le sursis de trente jours d'O.B — et l'acteur qui l'a
  /// prononcée.
  ///
  /// Aucune des quatre ne touche à l'argent. Un paiement ne devient
  /// encaissé ou remboursé que par la confirmation signée du fournisseur
  /// (INV-7) ; « remboursement à initier » est une issue de guichet, pas
  /// un virement.
  discrepancyOutcome    DiscrepancyOutcome?
  discrepancyNote       String?
  discrepancyResolvedAt DateTime?
  discrepancyResolvedBy String?

  /// Quand l'argent est reparti — M.B.
  ///
  /// Un reçu est une pièce comptable : « ce paiement a été remboursé » sans
  /// date n'en est pas une. La base tient les deux ensemble — l'état ne va
  /// pas sans la date, ni la date sans l'état.
  refundedAt DateTime?

  /// Quand un remboursement a été **décidé** — K.C.
  ///
  /// À ne pas confondre avec `refundedAt`, et c'est tout l'intérêt de deux
  /// colonnes : l'une dit qu'on doit rendre l'argent, l'autre qu'il est
  /// parti. La plateforme n'appelle aucune API de remboursement — le
  /// fournisseur de paiement n'est pas branché (I.C) — et écrire `REMBOURSEE`
  /// au moment de la décision annoncerait un virement que personne n'a fait.
  /// L'obligation s'ouvre ici, se voit en B-04, et c'est la notification
  /// signée qui la solde.
  refundDueAt DateTime?

  /// La demande envoyée au fournisseur — arbitrage du 21/09/2026.
  ///
  /// Le troisième fait, celui qui manquait. K.C écrit la décision de
  /// rembourser, M.B écrit la confirmation que l'argent est reparti ;
  /// entre les deux, personne ne disait si la demande était partie. Une
  /// obligation ouverte et une demande acceptée se lisaient pareil, et
  /// une tentative échouée ne laissait aucune trace.
  ///
  /// C'est un accusé de réception du fournisseur, jamais un virement :
  /// seule sa notification signée fait passer la transaction à
  /// `REMBOURSEE` (INV-7).
  refundRequestedAt DateTime?
  /// La dernière tentative, réussie ou non — une dette dont l'envoi
  /// échoue reste une dette, et il faut savoir depuis quand on essaie.
  refundAttemptedAt DateTime?
  refundAttempts    Int       @default(0)
  /// Pourquoi il est dû, en clair. Une obligation sans motif ne se traite
  /// pas : l'opérateur qui la voit doit savoir si elle vient de la règle ou
  /// d'un geste, et lequel.
  refundBasis       String?

  credits AnalysisCredit[]
  events  PaymentEvent[]

  @@index([status, createdAt])
  @@index([reconciledAt, createdAt])
  @@index([refundDueAt, refundedAt])
  @@index([discrepancyResolvedAt])
  @@index([refundRequestedAt, refundedAt])
}

/// L'issue d'un écart de réconciliation — arbitrage du 21/09/2026.
///
/// Quatre valeurs fermées, parce qu'un champ libre redeviendrait le texte
/// que personne ne compte. Chacune dit ce qu'il advient de la vigilance,
/// pas ce qu'il advient de l'argent.
enum DiscrepancyOutcome {
  /// Le désaccord s'explique, et rien ne bouge côté argent.
  EXPLIQUE_SANS_CORRECTION
  /// On attend encore le fournisseur : l'écart se referme, la vigilance non.
  ATTENTE_CONFIRMATION
  /// Une somme est à rendre. L'obligation s'ouvre ailleurs, pas ici.
  REMBOURSEMENT_A_INITIER
  /// Transmis pour investigation : ce n'est plus une question de guichet.
  INCIDENT_TRANSMIS
}

/// Une notification reçue d'un fournisseur — clé d'idempotence, INV-7, M.B.
///
/// L'idempotence se tenait sur `Transaction.providerTxId`, c'est-à-dire sur
/// la transaction et non sur l'événement. Une transaction en reçoit
/// plusieurs — confirmation puis remboursement — et le second se lisait
/// comme un rejeu du premier chaque fois que le fournisseur réutilisait son
/// identifiant. La clé porte maintenant sur la notification elle-même.
///
/// La ligne est écrite dans la même transaction de base que le changement
/// d'état : un rejeu bute sur l'unicité et le changement est annulé avec
/// lui. Elle laisse en outre la trace de ce qui est arrivé et dans quel
/// ordre, ce que l'ancienne colonne écrasait à chaque notification.
model PaymentEvent {
  id              String            @id @default(uuid())
  providerEventId String            @unique
  transactionId   String
  transaction     Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// L'état annoncé, pas l'état atteint : une notification refusée par la
  /// table du cycle ne laisse pas de ligne, mais celles qui passent disent
  /// ce qu'elles ont demandé.
  announced       TransactionStatus
  receivedAt      DateTime          @default(now())

  @@index([transactionId, receivedAt])
}

/// Comptage des tokens, pas des « vérifications » (INV-6).
model AiUsage {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  operation     String
  inputTokens   Int
  outputTokens  Int
  costMicros    Int
  createdAt     DateTime     @default(now())

  @@index([applicationId, createdAt])
}

/// Le dernier constat d'un service extérieur — I.C, 22/09/2026.
///
/// Il était tenu dans une variable de module. Le worker le posait, le
/// processus web le lisait, et les deux ne partagent aucune mémoire : la
/// lecture rendait « aucune sonde n'a tourné » indéfiniment. La base est
/// le seul état que les deux processus ont en commun.
///
/// Une ligne par service, écrasée : c'est l'état courant qui décide, et
/// un historique de sondes n'apprendrait rien que le journal ne dise.
model ServiceProbe {
  /// La clé de la dépendance : « messagerie », « antivirus ».
  service    String   @id
  /// Le service a répondu **comme il devait**, pas seulement répondu.
  succeeded  Boolean
  observedAt DateTime
  /// La forme de ce qui s'est passé. Jamais un secret, jamais un corps.
  detail     String?

  @@index([observedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  target    String
  /// Motif obligatoire pour tout accès à une pièce d'identité (RG-15.1).
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([target, createdAt])
}

// ═══════════════════════════════════════════════════════════
// Versions de pièce, analyse et revue humaine
// ═══════════════════════════════════════════════════════════

/// Version déposée d'une pièce — fichier téléversé (C-07) ou texte rédigé
/// (R-03). Les deux vivent ici : ce sont les mêmes versions dans la même
/// checklist, et les séparer obligerait chaque écran à savoir laquelle lire.
///
/// `checksum` porte RG-06.2 : une pièce re-téléversée à l'identique réutilise
/// le verdict en cache, sans débit de quota. L'unicité par document le rend
/// vrai en base plutôt qu'en intention.
/// États du balayage antivirus — I.D, tranché le 20/09/2026.
///
/// L'indisponibilité du moteur n'est pas un état : un fichier que personne
/// n'a pu lire reste `EN_QUARANTAINE`. Mieux vaut un fichier en attente
/// qu'un fichier accepté par défaut.
enum ScanState {
  EN_QUARANTAINE
  SAINE
  INFECTEE
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rank       Int

  /// Clé MinIO du fichier. Nulle pour une pièce rédigée.
  objectKey String?
  checksum  String?
  mimeType  String?
  sizeBytes Int?

  /// Texte d'une pièce rédigée. Nul pour un fichier.
  body       String?
  wordCount  Int?
  /// Ce qui a changé, en une phrase. Une liste de versions sans motif ne se lit pas.
  changeNote String?

  uploadedAt DateTime  @default(now())
  /// Contenu supprimé, métadonnées conservées (INV-5, RG-10.1).
  purgedAt   DateTime?

  /// Balayage antivirus — I.D. Une version naît en quarantaine : ce n'est
  /// pas une valeur par défaut de commodité, c'est l'état réel d'un fichier
  /// que personne n'a encore lu. Une version rédigée n'a pas d'octet à
  /// balayer ; son état ne décide de rien, puisque c'est `objectKey` qui
  /// commande l'accès.
  scanState   ScanState @default(EN_QUARANTAINE)
  /// Nulle tant que rien n'a été balayé — la contrainte l'impose.
  scannedAt   DateTime?
  /// Le nom donné à la menace par le moteur. Écrit pour le back-office,
  /// jamais montré au candidat : il n'est pas actionnable (RG-06.3).
  scanFinding String?

  /// Tentatives de balayage restées sans verdict. Remises à zéro dès qu'un
  /// verdict tombe : le compteur mesure une attente en cours, pas un passé.
  scanAttempts      Int       @default(0)
  scanLastAttemptAt DateTime?
  /// Posée quand l'attente cesse d'être ordinaire — tout de suite pour une
  /// cause qui ne se reprend pas, au bout de trois tentatives sinon. Elle
  /// rend l'incident visible en exploitation ; elle n'accepte rien.
  scanIncidentAt    DateTime?
  /// La cause, telle que `CauseDIndisponibilite` la nomme. Dit à
  /// l'exploitant s'il doit attendre ou intervenir.
  scanIncidentCause String?

  /// Tentatives de lecture automatique restées sans résultat. Remises à zéro
  /// dès qu'un verdict tombe : le compteur mesure une attente en cours, pas
  /// un passé. Au-delà de trois, la pièce part en revue humaine — DOC-11,
  /// WF-06, cas limites.
  analysisAttempts      Int       @default(0)
  analysisLastAttemptAt DateTime?

  /// Date de l'analyse critique de ce texte — WF-08 étape 4.
  ///
  /// Nulle tant que la relecture n'a pas eu lieu, et c'est la seule chose
  /// qui distingue « relu, rien à reprendre » de « jamais relu » : les deux
  /// rendent une liste de remarques vide. R-04 lisait la seconde comme la
  /// première, sur la foi d'une variable d'environnement.
  critiquedAt DateTime?

  analyses DocumentAnalysis[]
  findings CritiqueFinding[]

  @@unique([documentId, rank])
  @@unique([documentId, checksum])
  @@index([documentId, uploadedAt])
  @@index([scanState, uploadedAt])
  @@index([scanIncidentAt])
}

enum AnalysisVerdict {
  CONFORME
  A_CORRIGER
  ILLISIBLE
  HORS_SUJET
}

/// Résultat d'une analyse de pièce (C-08, WF-06).
///
/// `creditConsumed` est stocké et non déduit du verdict : une reprise après
/// ILLISIBLE ne débite rien (WF-06, cas limites), une relecture humaine peut
/// rendre l'analyse, et un verdict réutilisé sur empreinte identique ne
/// coûte pas non plus. Recalculer la règle à la lecture la ferait diverger
/// du grand livre de crédits.
model DocumentAnalysis {
  id             String          @id @default(uuid())
  versionId      String
  version        DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  verdict        AnalysisVerdict
  /// Champs lus, affichés en regard de l'exigence (C-08).
  fields         Json?
  /// Titre et corps du verdict, actionnables (RG-06.3).
  title          String
  body           String
  /// Trace technique de la lecture, pour l'opérateur seul (B-05).
  engineLog      String?
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  creditConsumed Boolean         @default(true)
  analyzedAt     DateTime        @default(now())

  review ManualReview?

  @@index([verdict, analyzedAt])
}

enum ReviewReason {
  SIGNALE_PAR_LE_CANDIDAT
  ECHEC_TECHNIQUE
  DOCUMENT_NON_RECONNU
  NETTETE_INSUFFISANTE
}

/// Revue manuelle d'une pièce en échec (B-05, WF-15).
///
/// `message` est obligatoire dès qu'une décision est prise : c'est RG-06.3
/// appliqué à un humain plutôt qu'à la machine. La contrainte vit dans la
/// migration, pas seulement dans l'écran.
model ManualReview {
  id             String           @id @default(uuid())
  analysisId     String           @unique
  analysis       DocumentAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reason         ReviewReason
  queuedAt       DateTime         @default(now())
  reviewerId     String?
  decision       AnalysisVerdict?
  /// Message envoyé au candidat. Jamais « non conforme » seul (RG-06.3).
  message        String?
  /// Une analyse rendue recrédite le quota : la lecture n'a rien rendu.
  creditRefunded Boolean          @default(false)
  decidedAt      DateTime?

  @@index([decidedAt, queuedAt])
}

// ═══════════════════════════════════════════════════════════
// Quota d'analyses — grand livre
// ═══════════════════════════════════════════════════════════

enum CreditReason {
  ACHAT_PACK
  RECHARGE
  ANALYSE
  ANALYSE_RENDUE
  GESTE_COMMERCIAL
  /// Retrait des droits non consommés à l'initiation d'un remboursement.
  /// Une écriture négative de plus, jamais une suppression : les analyses
  /// déjà consommées gardent leurs lignes.
  REMBOURSEMENT
}

/// Grand livre du quota d'analyses (INV-6).
///
/// Un solde stocké se désynchronise du jour où une écriture échoue à
/// mi-chemin ; un grand livre se recompte. C'est aussi la seule forme qui
/// rend un recréditement traçable : « 2 analyses rendues après pièces
/// illisibles » est une ligne, pas une soustraction silencieuse.
///
/// `delta` est positif à l'octroi, négatif à la consommation. Le solde est
/// la somme, et il ne descend jamais sous zéro : jamais de dépassement
/// silencieux.
model AnalysisCredit {
  id            String       @id @default(uuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  delta         Int
  reason        CreditReason
  /// Achat qui a ouvert le quota, le cas échéant.
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  /// Analyse qui l'a consommé ou rendu, le cas échéant.
  analysisId    String?
  note          String?
  createdAt     DateTime     @default(now())

  @@index([applicationId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// Rédaction assistée
// ═══════════════════════════════════════════════════════════

/// Réponse à une question de l'entretien guidé (R-02, WF-08).
///
/// Elles sont conservées à mesure, pour que l'entretien se reprenne. Le texte
/// produit vient d'elles et de rien d'autre : c'est ce qui sépare une mise en
/// forme d'une fabrication (RG-08.2).
model InterviewAnswer {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rank       Int
  section    String
  question   String
  answer     String
  updatedAt  DateTime @updatedAt

  @@unique([documentId, rank])
}

enum CritiqueKind {
  INCOHERENCE
  A_RENFORCER
  FORME
}

/// Remarque d'analyse critique (R-04, WF-08).
///
/// Elle relève une incohérence ou une imprécision. Il n'y a volontairement
/// aucune note ni aucun score : une note portée sur une lettre se retiendrait
/// comme un pronostic sur la décision (INV-1).
model CritiqueFinding {
  id         String          @id @default(uuid())
  versionId  String
  version    DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind       CritiqueKind
  title      String
  body       String
  /// Les deux valeurs qui divergent, avec la pièce qui les porte (RG-08.3).
  gaps       Json?
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([versionId, kind])
}

// ═══════════════════════════════════════════════════════════
// Alertes et divergence réglementaire
// ═══════════════════════════════════════════════════════════

enum NotificationKind {
  REGLEMENTATION
  ECHEANCE
  ANALYSE
  PAIEMENT
  VEILLE
}

/// Alerte adressée à un candidat (T-01, WF-11).
///
/// `dueAt` porte la date visée par une alerte d'échéance : le délai
/// « dans 7 jours » se recalcule à l'affichage. Écrit dans le titre, il
/// resterait affiché le jour même, puis une semaine après.
///
/// RG-11.2 : les alertes sont ciblées par dossier, jamais diffusées à toute
/// la base — d'où `applicationId` plutôt qu'un envoi par destination.
model Notification {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          NotificationKind
  title         String
  body          String
  /// Source réglementaire, quand l'alerte en cite une (INV-8).
  sourceUrl     String?
  dueAt         DateTime?        @db.Date
  /// Migration à arbitrer, le cas échéant : l'alerte ouvre T-02.
  migrationId   String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

enum RuleImpact {
  MINEUR
  MAJEUR
  CRITIQUE
}

enum MigrationDecision {
  MIGRER
  CONSERVER
}

/// Arbitrage d'une divergence réglementaire (T-02, WF-11).
///
/// INV-3 tient ici : publier une version ne migre aucun dossier. La ligne
/// existe dès la publication, `decision` reste nulle tant que le candidat
/// n'a pas tranché, et rien ne change dans sa checklist entre-temps. Migrer
/// d'office aurait rendu ce modèle inutile — c'est précisément pourquoi il
/// existe.
model RuleMigration {
  id            String             @id @default(uuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromRuleId    String
  fromRule      VisaRule           @relation("MigrationFrom", fields: [fromRuleId], references: [id])
  toRuleId      String
  toRule        VisaRule           @relation("MigrationTo", fields: [toRuleId], references: [id])
  impact        RuleImpact
  /// Diff calculé à la publication, affiché côte à côte (T-02).
  diff          Json
  decision      MigrationDecision?
  decidedAt     DateTime?
  createdAt     DateTime           @default(now())

  @@unique([applicationId, toRuleId])
  @@index([decision, createdAt])
}

/// Relevé d'une source de veille (B-01, WF-14).
///
/// Une source muette ne vaut pas un changement de règle : l'échec est
/// enregistré ici, et rien n'est dépublié (RG-14.3). C'est ce qui permet à
/// l'écran d'annoncer « 13 sources sur 14 » avec un compte exact plutôt
/// qu'un « collecte partielle » invérifiable.
model SourceCheck {
  id         String   @id @default(uuid())
  sourceUrl  String
  checkedAt  DateTime @default(now())
  reachable  Boolean
  attempts   Int      @default(1)
  error      String?
  /// Écart constaté par rapport à la règle publiée, le cas échéant.
  difference String?

  @@index([checkedAt])
  @@index([sourceUrl, checkedAt])
}

// ═══════════════════════════════════════════════════════════
// Consultants habilités (WF-12)
// ═══════════════════════════════════════════════════════════

model Consultant {
  id            String   @id @default(uuid())
  name          String
  firm          String
  city          String
  /// Mention d'agrément et ancienneté, affichées telles quelles (T-04).
  qualification String
  languages     Json
  /// Délai de réponse annoncé, en heures.
  responseHours Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  accreditations Accreditation[]
  accesses       ConsultantAccess[]
  appointments   Appointment[]
}

/// Habilitation par destination (RG-12.1).
///
/// Elle atteste qu'un titre d'exercice a été vérifié dans la juridiction
/// concernée — RCIC pour le Canada, l'équivalent ailleurs. Elle ne dit rien
/// de l'issue d'une demande, et l'annuaire le dit en toutes lettres (INV-1).
///
/// Une habilitation retirée reste en table, datée : la retirer effacerait la
/// preuve qu'elle a existé quand un rendez-vous a eu lieu.
model Accreditation {
  id           String     @id @default(uuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  countryCode  String     @db.Char(2)
  /// Titre vérifié : « RCIC », « avocat au barreau d'Amsterdam »…
  title        String
  verifiedAt   DateTime   @db.Date
  verifiedBy   String
  revokedAt    DateTime?

  @@unique([consultantId, countryCode])
  @@index([countryCode, revokedAt])
}

/// Accord nominatif d'accès à un dossier (RG-12.2).
///
/// Deux conditions cumulées avec l'habilitation, et aucune ne couvre
/// l'autre : la première répond à la compétence, celle-ci au consentement.
///
/// `expiresAt` est obligatoire : le partage est révocable **et** expire de
/// lui-même. Un accord sans échéance survit à la consultation qui l'a
/// motivé, et personne ne pense à le retirer.
model ConsultantAccess {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  consultantId  String
  consultant    Consultant  @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  grantedAt     DateTime    @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([applicationId, revokedAt])
  @@index([consultantId, expiresAt])
}

enum AppointmentStatus {
  /// Créneau gardé le temps du paiement. Rien n'est promis, rien n'est ouvert.
  TENU
  RESERVE
  HONORE
  ANNULE
  REPORTE
  ABSENT
}

/// Rendez-vous avec un consultant (T-05, WF-12).
///
/// `reference` est unique et dérivée du créneau et du consultant : une
/// réservation rejouée n'en crée pas deux, comme le paiement qui la précède
/// est idempotent (INV-7).
model Appointment {
  id            String            @id @default(uuid())
  reference     String            @unique
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  consultantId  String
  consultant    Consultant        @relation(fields: [consultantId], references: [id])
  startsAt      DateTime
  durationMin   Int
  status        AppointmentStatus @default(RESERVE)
  /// Limite d'annulation sans frais, calculée au créneau moins le délai de
  /// la grille. Stockée parce qu'elle est opposable : la grille peut changer
  /// après la réservation, pas la condition acceptée ce jour-là.
  freeUntil     DateTime
  /// Le paiement qui a confirmé ce rendez-vous.
  ///
  /// Un `RESERVE` sans transaction est refusé par la base
  /// (`appointment_reserve_exige_un_paiement`) : c'est là que se tient
  /// l'arbitrage, et non dans la bonne volonté des appelants.
  transactionId String?           @unique
  /// Jusqu'à quand la tenue vaut. Passé ce délai, le créneau se reprend —
  /// sans quoi un paiement abandonné gèlerait un horaire pour toujours.
  heldUntil     DateTime?
  /// Quand l'accord de partage a été donné (RG-12.2).
  ///
  /// Il se prépare avant le paiement : il n'y a aucune raison de le
  /// redemander après. Mais une date d'accord n'est pas une autorisation
  /// de lecture — l'accès consultant naît à la confirmation, pas ici.
  consentAt     DateTime?
  createdAt     DateTime          @default(now())

  @@unique([consultantId, startsAt])
  @@index([applicationId, startsAt])
}

// ═══════════════════════════════════════════════════════════
// Affiliation partenaires (WF-13)
// ═══════════════════════════════════════════════════════════

enum PartnerKind {
  ASSURANCE_SANTE
  LOGEMENT
  EQUIVALENCE_DIPLOME
  TRANSFERT_FONDS
  CONSULTANT
}

/// Partenaire affilié — WF-13.
///
/// Rien n'est proposé par défaut. Un partenaire sans activation pour la
/// destination du dossier n'existe pas pour ce dossier : RG-13.4 demande que
/// la rétro-commission soit vérifiée destination par destination, et cette
/// vérification est encadrée voire prohibée selon les pays. Le modèle refuse
/// donc l'inverse — une activation mondiale par défaut, restreinte ensuite.
///
/// Le taux de commission est **stocké sur le partenaire** et recopié sur la
/// proposition au moment où elle est faite. Le taux annoncé au candidat ce
/// jour-là est celui qui sera facturé, même si la grille change après.
model Partner {
  id            String      @id @default(uuid())
  name          String
  kind          PartnerKind
  city          String?
  /// Mention affichée telle quelle sous le nom : « agréé, 9 ans d'exercice ».
  qualification String?
  /// Destination de la redirection tracée (WF-13, étape 2).
  url           String
  /// Taux de commission en points de base : 1500 pour 15 %. Un entier, pour
  /// que le taux annoncé et le taux facturé soient le même nombre exact.
  commissionBps Int
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  activations PartnerActivation[]
  referrals   PartnerReferral[]
}

/// Activation d'un partenaire sur une destination (RG-13.4).
///
/// Même forme qu'`Accreditation` pour les consultants, et pour la même
/// raison : la vérification porte sur un couple, pas sur un tiers. Une
/// activation retirée reste en table, datée — l'effacer supprimerait la
/// preuve qu'elle existait le jour où une redirection a été tracée.
model PartnerActivation {
  id          String    @id @default(uuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  countryCode String    @db.Char(2)
  /// Ce qui a été vérifié : « rétro-commission licite, art. L. 561-2 ».
  basis       String
  verifiedAt  DateTime  @db.Date
  verifiedBy  String
  revokedAt   DateTime?

  @@unique([partnerId, countryCode])
  @@index([countryCode, revokedAt])
}

enum ReferralStatus {
  PROPOSEE
  REDIRIGEE
  ABOUTIE
  SANS_SUITE
  DECLINEE
}

/// Proposition de partenaire et redirection tracée — WF-13, écran T-03.
///
/// La ligne existe dès la proposition, pas au clic : une proposition faite
/// et déclinée est une information, et sans elle on ne mesure que ce qui a
/// rapporté. C'est aussi ce qui rend « refuser ne coûte rien » vérifiable.
///
/// `step` porte l'étape de checklist qui a déclenché la proposition
/// (RG-13.1). Une ligne sans étape est une réclame hors contexte ; la base
/// la refuse.
///
/// `commissionBps` est recopié du partenaire à la proposition, et
/// `commissionAmount` n'est écrit qu'à l'aboutissement : la commission est
/// au résultat, et un montant inscrit d'avance est une créance imaginaire.
model PartnerReferral {
  id            String         @id @default(uuid())
  partnerId     String
  partner       Partner        @relation(fields: [partnerId], references: [id])
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Étape de checklist qui motive la proposition (RG-13.1).
  step          String
  /// Situation déclarée par le candidat, telle qu'il l'a saisie (T-03).
  motive        String
  status        ReferralStatus @default(PROPOSEE)
  commissionBps Int

  proposedAt         DateTime  @default(now())
  redirectedAt       DateTime?
  settledAt          DateTime?
  /// Commission perçue, dans la devise du montant facturé par le partenaire.
  commissionAmount   Int?
  commissionCurrency String?   @db.Char(3)

  /// Une proposition par partenaire et par étape. Un candidat qui a dit non
  /// ne se voit pas reproposer la même chose au rechargement de l'écran :
  /// c'est cette clé qui rend « refuser ne coûte rien » vrai plus d'une
  /// seconde.
  @@unique([applicationId, partnerId, step])
  @@index([applicationId, status])
  @@index([partnerId, status, proposedAt])
}

/// Document éditorial — guide pays (P-05) ou article (P-07), B-08.
///
/// Les deux écrans publics lisaient un fichier du dépôt : un guide ne se
/// changeait pas sans un développeur et un déploiement, et le vocabulaire
/// interdit ne protégeait personne là où `CLAUDE.md` promet qu'il protège.
///
/// Ce qui se dérive du corps n'est pas ici : ni le sommaire, ni la durée de
/// lecture, ni la mention de fin. Une colonne qui recopie ce qu'un calcul
/// donne finit par le contredire.
model EditorialDoc {
  id     String          @id @default(uuid())
  kind   EditorialKind
  /// Adresse publique. Figée après la première publication : un lien
  /// entrant qui tombe est un lecteur perdu, et c'est tout l'intérêt d'un
  /// contenu de référencement.
  slug   String
  status EditorialStatus @default(BROUILLON)

  title      String
  /// Chapeau : les deux phrases sous le titre, et la description de la page.
  standfirst String

  /// Blocs et appel à l'action, validés par `domain/editorial/document.ts`.
  body Json

  /// INV-8 — toute information réglementaire affichée porte sa source et sa
  /// date de vérification. La base refuse une publication sans elles.
  sourceLabel String?
  verifiedAt  DateTime?

  /// Guide : le pays affiché en surtitre. Article : la rubrique et l'auteur.
  countryLabel String?
  section      String?
  author       String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions EditorialVersion[]

  @@unique([kind, slug])
  @@index([kind, status])
}

/// Ce qui était public, et depuis quand — P.B.
///
/// Une version par publication, jamais par enregistrement de brouillon :
/// l'historique de toutes les frappes coûterait cher et ne dirait rien.
/// Ce qu'on veut savoir tient en une phrase — quel texte un lecteur a-t-il
/// pu lire le 12 mars — et seule une publication change la réponse.
///
/// **Immuable.** Aucun chemin de code ne la réécrit ni ne la supprime :
/// c'est la même immuabilité que celle du journal d'audit, tenue de la
/// même façon, par l'absence d'écrivain et par un test qui la vérifie. Une
/// version qu'on pourrait corriger ne prouverait plus rien.
///
/// Restaurer n'est pas ressusciter : republier le texte d'une ancienne
/// version crée une version de plus, dont le contenu se trouve être
/// l'ancien. L'histoire ne se réécrit pas, elle s'allonge.
model EditorialVersion {
  id    String       @id @default(uuid())
  docId String
  doc   EditorialDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  /// Rang de publication, continu par document : la première vaut 1.
  rang  Int

  title       String
  standfirst  String
  body        Json
  /// INV-8 au niveau de la version, et non nullable : ce qui a été public
  /// portait forcément sa source et sa date, puisque la base l'exigeait
  /// déjà du document. Une version qui pourrait s'en passer laisserait
  /// croire qu'un document a pu être publié sans elles.
  sourceLabel String
  verifiedAt  DateTime

  countryLabel String?
  section      String?
  author       String?

  /// Qui a rendu ce texte public, et pourquoi — le motif du journal.
  publishedBy String
  reason      String
  publishedAt DateTime @default(now())

  @@unique([docId, rang])
  @@index([docId, publishedAt])
}

enum EditorialKind {
  GUIDE
  ARTICLE
}

enum EditorialStatus {
  BROUILLON
  PUBLIE
  /// Dépublié. La ligne survit : l'adresse a été indexée, et savoir qu'un
  /// document a existé vaut mieux que de ne plus rien savoir de lui.
  RETIRE
}
