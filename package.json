{
  "name": "immipro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:copy": "tsx scripts/check-forbidden-copy.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:copy",
    "seed:rules": "tsx prisma/seed/visa-rules.ts",
    "worker": "tsx src/server/jobs/worker.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:garde-fous": "psql \"$DATABASE_URL\" -f scripts/verifier-garde-fous.sql",
    "db:studio": "prisma studio",
    "seed:demo": "tsx prisma/seed/demonstration.ts",
    "seed:editorial": "tsx prisma/seed/editorial.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@prisma/client": "^6.0.0",
    "clsx": "^2.1.0",
    "minio": "^8.0.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.0",
    "pg-boss": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.0.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
